{
  "name": "reto-03-beltran",
  "version": "1.0.0",
  "description": "Agente conversacional de órdenes de compra SAP (Reto 03)",
  "scripts": {
    "test": "vitest run && npm run test -w web",
    "dev": "concurrently -n back,web -c blue,green \"tsx watch --env-file-if-exists=.env src/server.ts\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "demo": "tsx demo.ts",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "^22.9"
  },
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "express": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "web"
  ]
}
