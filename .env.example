# Clave de Google Gemini (https://aistudio.google.com/apikey). Obligatoria para el chat;
# no se necesita para la demo ni los tests.
GEMINI_API_KEY=
# Modelos; si se dejan vacíos se usan gemini-3.6-flash y, de respaldo,
# gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview
LLM_MODELO=
# Modelos de respaldo, separados por comas y en orden, si el principal no está disponible
# (caída, límite, timeout o rechazo); el plan gratuito limita el cupo diario por modelo
LLM_MODELO_RESPALDO=
LLM_TIMEOUT_MS=60000
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TOKENS_DIA=3000000
MAX_SESIONES=200
# Plazo máximo de un turno completo del agente, en segundos
MAX_SEGUNDOS_TURNO=240
# Mensajes de chat permitidos por IP y por minuto
MAX_SOLICITUDES_MINUTO=20
PORT=3000
