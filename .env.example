# Clave del modelo (obligatoria para el chat; no se necesita para la demo ni los tests)
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
# Modelo de respaldo si el principal no está disponible (caída, límite, timeout o rechazo)
LLM_MODELO_RESPALDO=claude-sonnet-5-5
LLM_TIMEOUT_MS=60000
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
MAX_TOKENS_DIA=3000000
MAX_SESIONES=200
# Plazo máximo de un turno completo del agente, en segundos
MAX_SEGUNDOS_TURNO=240
# Mensajes de chat permitidos por IP y por minuto
MAX_SOLICITUDES_MINUTO=20
PORT=3000
